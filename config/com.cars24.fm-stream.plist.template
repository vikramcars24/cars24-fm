<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.cars24.fm-stream</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-dimsu</string>
    <string>/Applications/OBS.app/Contents/MacOS/OBS</string><string>--startstreaming</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>StandardOutPath</key><string>/tmp/cars24-fm-obs.log</string>
  <key>StandardErrorPath</key><string>/tmp/cars24-fm-obs-error.log</string>
</dict></plist>
